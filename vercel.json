{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/app run build",
  "outputDirectory": "artifacts/app/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "env": {
    "NODE_VERSION": "20"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}